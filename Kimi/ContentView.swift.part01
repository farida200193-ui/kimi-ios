import SwiftUI

struct ContentView: View {
    @StateObject private var chat = ChatModel()
    @StateObject private var voice = Voice()
    @State private var draft = ""
    @State private var showSettings = Keychain.read().isEmpty
    @Environment(\.scenePhase) private var scenePhase

    private var phase: KimiPhase {
        voice.listening ? .listening : chat.busy ? .thinking : voice.speaking ? .speaking : .idle
    }

    var body: some View {
        NavigationView {
            VStack(spacing: 0) {
                messageList
                if let error = chat.error {
                    Text(error).font(.footnote).foregroundColor(.red).padding(.horizontal).padding(.top, 6)
                }
                if voice.listening {
                    Text(voice.heard.isEmpty ? "Слушаю…" : voice.heard)
                        .font(.footnote).foregroundColor(.secondary).padding(.top, 6)
                } else if let note = voice.note {
                    Text(note).font(.footnote).foregroundColor(.red).padding(.horizontal).padding(.top, 6)
                }
                inputBar
            }
            .navigationTitle("Kimy")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarLeading) {
                    Button("Новый чат") { chat.clear() }.disabled(chat.busy)
                }
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button { showSettings = true } label: { Image(systemName: "gearshape") }
                        .accessibilityLabel("Настройки")
                }
            }
            .sheet(isPresented: $showSettings) { SettingsView() }
        }
        .navigationViewStyle(.stack)
        // Kimi stays in the Dynamic Island / on the lock screen after the app is minimised
        .onAppear { Island.shared.refresh(phase) }
        .onChange(of: phase) { Island.shared.show($0) }
